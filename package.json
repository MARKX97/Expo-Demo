{
  "name": "elevator-handoff",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare": "husky",
    "start": "expo start --dev-client",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest __tests__",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "test:db": "supabase test db",
    "types:generate": "supabase gen types typescript --local --schema public > src/types/database.generated.ts",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:fast": "pnpm run typecheck && pnpm run lint && pnpm run test:unit",
    "verify": "pnpm run verify:docs && pnpm exec expo-doctor && pnpm run verify:fast && pnpm run test:db && pnpm run test:integration"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.8",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-image-manipulator": "~57.0.7",
    "expo-image-picker": "~57.0.7",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@jest/globals": "~29.7.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "expo-doctor": "^1.20.1",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "packageManager": "pnpm@11.9.0"
}
